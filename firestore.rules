rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Piso de 16 filas (A–P) por 20 columnas (1–20). Si cambian las medidas, ajustar aquí también.
    function coordenadaValida(coordenada) {
      return coordenada.matches('^[A-P]([1-9]|1[0-9]|20)$');
    }

    function cuartoValido(cuarto) {
      return cuarto is string && cuarto.size() <= 80;
    }

    // Una celda es un metro dividido en 4 cuartos; cada cuarto trae el nombre de quien lo aportó o '' si está libre.
    function cuartosValidos(cuartos) {
      return cuartos is list
        && cuartos.size() == 4
        && cuartoValido(cuartos[0])
        && cuartoValido(cuartos[1])
        && cuartoValido(cuartos[2])
        && cuartoValido(cuartos[3])
        && (cuartos[0] != '' || cuartos[1] != '' || cuartos[2] != '' || cuartos[3] != '');
    }

    function datosValidos() {
      return request.resource.data.keys().hasOnly(['cuartos', 'fecha'])
        && cuartosValidos(request.resource.data.cuartos)
        && request.resource.data.fecha == request.time;
    }

    // Un cuarto ocupado solo puede liberarse (quedar ''), nunca pasar de una persona a otra.
    function respetaCuarto(i) {
      let antes = resource.data.get('cuartos', ['', '', '', '']);
      let despues = request.resource.data.cuartos;
      return despues[i] == antes[i] || antes[i] == '' || despues[i] == '';
    }

    match /celdas/{coordenada} {
      allow read: if true;

      allow create: if esAdmin() && coordenadaValida(coordenada) && datosValidos();

      allow update: if esAdmin() && coordenadaValida(coordenada) && datosValidos()
        && respetaCuarto(0) && respetaCuarto(1) && respetaCuarto(2) && respetaCuarto(3);

      allow delete: if esAdmin();
    }

    // Fondo común de excedentes: quién dejó cuánto y en qué se usó. Solo lo ven los administradores.
    function movimientoValido() {
      let m = request.resource.data;
      return m.keys().hasOnly(['nombre', 'centavos', 'tipo', 'nota', 'origen', 'fecha'])
        && (!('origen' in m) || m.origen in ['casillas', 'directo'])
        && m.nombre is string && m.nombre.size() > 0 && m.nombre.size() <= 80
        && m.centavos is int
        && ((m.tipo == 'excedente' && m.centavos > 0 && m.centavos <= 100000000)
          || (m.tipo == 'uso' && m.centavos < 0 && m.centavos >= -100000000))
        && m.nota is string && m.nota.size() <= 160
        && m.fecha == request.time;
    }

    match /excedentes/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && movimientoValido();
      allow update: if false;
      allow delete: if esAdmin();
    }

    // Dinero recibido de cada persona. Solo lo ven los administradores.
    function pagoValido() {
      let p = request.resource.data;
      return p.keys().hasOnly(['nombre', 'centavos', 'nota', 'fecha'])
        && p.nombre is string && p.nombre.size() > 0 && p.nombre.size() <= 80
        && p.centavos is int && p.centavos > 0 && p.centavos <= 100000000
        && p.nota is string && p.nota.size() <= 160
        && p.fecha == request.time;
    }

    match /pagos/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && pagoValido();
      allow update: if false;
      allow delete: if esAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Activación con código de acceso. El código vive solo aquí, nunca en el cliente.
      // TEMPORAL: reemplazar por un mecanismo mejor (invitaciones o una Cloud Function).
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo', 'email', 'fecha'])
        && request.resource.data.codigo == '1234'
        && request.resource.data.email is string
        && request.resource.data.fecha == request.time;

      allow delete: if false;
    }
  }
}
